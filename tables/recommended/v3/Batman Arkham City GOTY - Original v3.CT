              <Description>"Super Damage (10x-equivalent; Batarangs experimental) [-]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not AC then error('Enable Initialize Arkham City Table first.') end
local m=getAddressList().getMemoryRecordByID(23);if m and m.Active then m.Active=false end
AC.setFlag('superDamage',true)
{$asm}
