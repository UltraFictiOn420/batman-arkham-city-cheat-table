              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not AC then error('Enable Initialize Arkham City Table first.') end
AC.setFlag('freeze',true)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if AC then AC.setFlag('freeze',false) end
{$asm}</AssemblerScript>
            </CheatEntry>
