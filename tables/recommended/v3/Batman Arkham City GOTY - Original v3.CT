              <Description>"One-Hit Knockout (Batarangs experimental) [=]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not AC then error('Enable Initialize Arkham City Table first.') end
local m=getAddressList().getMemoryRecordByID(22);if m and m.Active then m.Active=false end
AC.setFlag('oneHit',true)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if AC then AC.setFlag('oneHit',false) end
{$asm}</AssemblerScript>
              <Hotkeys>
                <Hotkey>
                  <Action>Toggle Activation</Action>
